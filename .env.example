# MPMB Copilot Environment Variables
# Copy this file to .env and fill in your actual values.
# .env is gitignored; never commit real secrets.
#
# Every key here maps to a field on backend/app/config.py (the single source of
# truth). Unlisted keys are ignored. Anything commented out falls back to the
# default shown.

# ==========================================
# Application
# ==========================================
ENVIRONMENT=development          # development | production | testing
DEBUG=true                       # verbose errors; leaks exception text when true, so keep false in production
LOG_LEVEL=INFO
LOG_DIR=./logs
LOG_RETENTION_DAYS=30
LOG_ERROR_RETENTION_DAYS=90

# ==========================================
# Auth / network exposure
# ==========================================
# BIND_HOST MUST mirror the host uvicorn actually binds. The exposure fail-safe
# keys off this value: on a non-loopback bind with no admin yet, first-run setup
# demands a one-time token printed to the logs (grep for "setup_token_required").
# Leave it loopback for local dev; the Docker stack sets 0.0.0.0.
BIND_HOST=127.0.0.1              # 127.0.0.1 | 0.0.0.0

# COOKIE_SECURE controls the Secure flag on the session cookie.
#   auto   - Secure when the request scheme is HTTPS (correct behind a proxy run
#            with uvicorn --proxy-headers); the sane default
#   always - force Secure (use if the proxy terminates TLS but the hop is HTTP)
#   never  - never set Secure (plain-HTTP LAN only)
COOKIE_SECURE=auto

# AUTH_DISABLED is a DEV-ONLY escape hatch: it skips login entirely. It is
# honored ONLY when BIND_HOST is loopback and can never disable auth on an
# exposed interface. Do not set this on anything reachable off-box.
# AUTH_DISABLED=false

# Session lifetime (absolute / idle days) and other tunables are runtime
# "hot" settings stored in data/settings.json, not environment variables.

# API_PREFIX=/api
# CORS: only needed when the SPA and API are served from different origins.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000,http://localhost:5001

# Service API key for ops scripts (index/rechunk) on an authed install.
# Mint one with: pnpm run mint-key  (not needed when AUTH_DISABLED=true on loopback)
SERVICE_API_KEY=

# ==========================================
# PostgreSQL (identity + session persistence)
# ==========================================
POSTGRES_USER=mpmb_user
POSTGRES_PASSWORD=mpmb_password_change_in_production
POSTGRES_DB=mpmb_copilot
POSTGRES_HOST=postgres           # "postgres" inside Docker; 127.0.0.1 when running the backend on the host
POSTGRES_PORT=5432               # 5432 inside Docker; the compose stack maps 5433 on the host

# Optional: override the assembled connection string (built from the parts above if unset).
# DATABASE_URL=postgresql://mpmb_user:mpmb_password_change_in_production@postgres:5432/mpmb_copilot

# ==========================================
# LLM providers
# ==========================================
DEFAULT_LLM_PROVIDER=anthropic   # anthropic | openai | ollama
DEFAULT_MODEL=claude-sonnet-4-20250514

# Anthropic
ANTHROPIC_API_KEY=sk-ant-xxxxx
# OpenAI
# OPENAI_API_KEY=sk-xxxxx
# Ollama (local)
# OLLAMA_HOST=http://localhost:11434

# Generation params
MAX_TOKENS=4000
TEMPERATURE=0.2

# Agentic tool use (the model calls search/read/grep tools when it decides to)
# ENABLE_TOOL_USE=false
# MAX_TOOL_CALLS=0
# ENABLE_EXTENDED_THINKING=false

# ==========================================
# Vector store (Qdrant)
# ==========================================
VECTOR_STORE=qdrant
QDRANT_HOST=qdrant               # "qdrant" inside Docker; 127.0.0.1 when running the backend on the host
QDRANT_PORT=6333
QDRANT_COLLECTION=mpmb_code
QDRANT_TIMEOUT=30

# ==========================================
# Embeddings
# ==========================================
# Provider options: fastembed (default, no API key), openai, ollama, sbert
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384
# ONNX thread cap during indexing (0 = auto: half the cores)
# EMBEDDING_THREADS=0

# ==========================================
# RAG / chunking parameters
# ==========================================
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K_RESULTS=8
SIMILARITY_THRESHOLD=0.5
CONTEXT_WINDOW_SIZE=8000
DEFAULT_EDITION=2014             # 2014 | 2024

# ==========================================
# File paths
# ==========================================
DATA_DIR=./data
ADOBE_DOCS_DIR=./data/adobe_docs
INDEX_CACHE_DIR=./data/index_cache
UPLOAD_DIR=./data/uploads
CHUNKED_OUTPUT_DIR=./data/chunked_output
# Override the analyzer-generated source catalog path.
# Default: ./scripts/analyze/reports/mpmb-analysis.json
# MPMB_CATALOG_PATH=./scripts/analyze/reports/mpmb-analysis.json

# ==========================================
# Source repositories (used by source-acquisition scripts)
# ==========================================
MPMB_SOURCE_DIR=./data/mpmb_source
MPMB_REPO_URL=https://github.com/morepurplemorebetter/MPMBs-Character-Record-Sheet.git
MPMB_REPO_BRANCH_2014=master

MPMB_SOURCE_2024_DIR=./data/mpmb_source_2024
MPMB_REPO_2024_URL=https://github.com/morepurplemorebetter/2024_MPMBs-Character-Record-Sheet.git
MPMB_REPO_BRANCH_2024=main

IMPORTS_SOURCE_DIR=./data/imports_source
IMPORTS_REPO_URL=https://github.com/safety-orange/Imports-for-MPMB-s-Character-Sheet.git

# Additional user-provided source directories (comma-separated), chunked as edition="unknown"
# USER_SOURCE_DIRS=./my-homebrew,./friend-content
