# MPMB Copilot Environment Variables
# Copy this file to .env and fill in your actual values

# ==========================================
# Application Settings
# ==========================================
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=false

# ==========================================
# LLM Provider Settings
# ==========================================
# Choose one: anthropic, openai, ollama
DEFAULT_LLM_PROVIDER=anthropic

# For Anthropic Claude
ANTHROPIC_API_KEY=sk-ant-xxxxx
DEFAULT_MODEL=claude-sonnet-4-20250514

# For OpenAI GPT
# OPENAI_API_KEY=sk-xxxxx
# DEFAULT_MODEL=gpt-4

# For Ollama (local)
# OLLAMA_HOST=http://localhost:11434
# DEFAULT_MODEL=codellama

# LLM Parameters
MAX_TOKENS=4000
TEMPERATURE=0.2

# ==========================================
# Vector Database (Qdrant)
# ==========================================
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=mpmb_code
QDRANT_TIMEOUT=30

# ==========================================
# Embedding Settings
# ==========================================
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# ==========================================
# RAG Parameters
# ==========================================
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K_RESULTS=5
SIMILARITY_THRESHOLD=0.7
CONTEXT_WINDOW_SIZE=8000

# ==========================================
# File Paths
# ==========================================
DATA_DIR=./data
MPMB_SOURCE_DIR=./data/mpmb_source
ADOBE_DOCS_DIR=./data/adobe_docs
INDEX_CACHE_DIR=./data/index_cache

# ==========================================
# CORS Settings
# ==========================================
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000,http://localhost:5001
