# MPMB Copilot Environment Variables
# Copy this file to .env and fill in your actual values

# ==========================================
# Application Settings
# ==========================================
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=true

# ==========================================
# PostgreSQL Database (Session Persistence)
# ==========================================
POSTGRES_USER=mpmb_user
POSTGRES_PASSWORD=mpmb_password_change_in_production
POSTGRES_DB=mpmb_copilot
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Connection string (auto-generated from above, but can override)
DATABASE_URL=postgresql://mpmb_user:mpmb_password_change_in_production@postgres:5432/mpmb_copilot

# ==========================================
# LLM Provider Settings
# ==========================================
# Choose one: anthropic, openai, ollama
DEFAULT_LLM_PROVIDER=anthropic

# For Anthropic Claude
ANTHROPIC_API_KEY=sk-ant-xxxxx
DEFAULT_MODEL=claude-sonnet-4-20250514

# For OpenAI GPT
# OPENAI_API_KEY=sk-xxxxx
# DEFAULT_MODEL=gpt-4

# For Ollama (local)
# OLLAMA_HOST=http://localhost:11434
# DEFAULT_MODEL=codellama

# LLM Parameters
MAX_TOKENS=4000
TEMPERATURE=0.2

# ==========================================
# Vector Database (Qdrant)
# ==========================================
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=mpmb_code
QDRANT_TIMEOUT=30

# ==========================================
# Embedding Settings
# ==========================================
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# ==========================================
# RAG Parameters
# ==========================================
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K_RESULTS=5
SIMILARITY_THRESHOLD=0.7
CONTEXT_WINDOW_SIZE=8000

# ==========================================
# File Upload Settings
# ==========================================
MAX_FILE_SIZE_MB=10
UPLOAD_DIR=./data/uploads
ALLOWED_FILE_TYPES=.js,.json,.txt,.md,.pdf,.png,.jpg,.jpeg

# ==========================================
# Session Settings
# ==========================================
SESSION_TIMEOUT_HOURS=24
MAX_SESSIONS_PER_USER=100
MAX_MESSAGES_PER_SESSION=1000

# ==========================================
# File Paths
# ==========================================
DATA_DIR=./data
MPMB_SOURCE_DIR=./data/mpmb_source
ADOBE_DOCS_DIR=./data/adobe_docs
INDEX_CACHE_DIR=./data/index_cache
LOGS_DIR=./logs

# ==========================================
# CORS Settings
# ==========================================
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000,http://localhost:5001

# ==========================================
# SignalR Hub Settings (.NET)
# ==========================================
HUB_URL=http://localhost:5000
SIGNALR_CONNECTION_TIMEOUT_SECONDS=30

# ==========================================
# Feature Flags
# ==========================================
ENABLE_FILE_UPLOADS=true
ENABLE_WEB_SEARCH=false
ENABLE_CODE_EXECUTION=false
ENABLE_SESSION_PERSISTENCE=true
