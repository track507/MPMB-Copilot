	},
	"dependencies": {
		"@eslint/js": "^10.0.1",
		"eslint": "^10.7.0"
	},
	"devDependencies": {
		"@types/node": "^26.2.0",
		"typescript": "^6.0.3",
		"vitest": "^4.1.10"
	}
}
