{
	"compilerOptions": {
		"target": "ES2025",
		"lib": ["ES2025"],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"allowJs": true,
		"checkJs": true,
		"noEmit": true,
		"types": ["node"]
	},
	// * Top-level scripts only; analyze/ and validate/ own their tsconfigs
	"include": ["*.mjs", "globals.d.ts"]
}
