{
	"compilerOptions": {
		"composite": true,
		"tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
		"target": "ES2025",
		"lib": ["ES2025"],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"skipLibCheck": true,
		"resolveJsonModule": true,
		"isolatedModules": true,
		"emitDeclarationOnly": true,
		"types": ["node"]
	},
	"include": ["vite.config.ts", "vitest.config.ts"]
}
